// End-to-end protection for SDP/ICE payloads relayed through the signaling
// server. The server relays `payload` opaquely, so encrypting it doesn't
// need any server change - but it does mean a signaling server can no
// longer read the SDP or, crucially, swap the DTLS fingerprints inside it.
// Since the browser refuses a DTLS handshake whose certificate doesn't
// match the remote description's a=fingerprint, authenticating the SDP is
// enough to authenticate the whole peer connection end to end, whichever
// signaling server (or TURN relay) sits in the middle.
//
// The room key is generated by the room's creator and only ever travels in
// a join link's URL fragment (see qr_join.mts), which browsers never send
// to a server. Uses AES-GCM via the native crypto.subtle, so this works
// unchanged under node:test as well as in the browser.

import type { RtcSignalType } from "./signaling_protocol.mjs";

// 128 bits: comfortably out of brute-force reach, and keeps the join URL
// short (22 base64url characters).
const ROOM_KEY_BYTES = 16;
const ROOM_KEY_ENCODED_LENGTH = 22;
const IV_BYTES = 12;
const ENVELOPE_VERSION = 1;
// Domain separation for the additional authenticated data, so these
// ciphertexts can never be mistaken for anything else encrypted under the
// same key in a future protocol version.
const AAD_LABEL = "hopdrop-signal";

export interface EncryptedSignalPayload {
  v: typeof ENVELOPE_VERSION;
  iv: string;
  ct: string;
}

// Who a payload is from/to and what kind it is. Bound into each ciphertext
// as GCM additional authenticated data, so a signaling server can't take a
// valid encrypted payload and redirect it to a different peer, replay it
// as a different message type, or claim it came from someone else - any
// of those makes decryption fail.
export interface SignalContext {
  type: RtcSignalType;
  from_device_id: string;
  to_device_id: string;
}

export class SignalDecryptionError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "SignalDecryptionError";
  }
}

function bytes_to_base64url(bytes: Uint8Array): string {
  let binary = "";
  for (const byte of bytes) {
    binary += String.fromCharCode(byte);
  }
  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function base64url_to_bytes(encoded: string): Uint8Array<ArrayBuffer> | null {
  if (!/^[A-Za-z0-9_-]*$/.test(encoded) || encoded.length % 4 === 1) {
    return null;
  }
  const padded =
    encoded.replace(/-/g, "+").replace(/_/g, "/") +
    "=".repeat((4 - (encoded.length % 4)) % 4);
  let binary: string;
  try {
    binary = atob(padded);
  } catch {
    return null;
  }
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) {
    bytes[i] = binary.charCodeAt(i);
  }
  return bytes;
}

function encode_aad(context: SignalContext): Uint8Array<ArrayBuffer> {
  // JSON array rather than plain concatenation, so field boundaries are
  // unambiguous whatever the device ids contain.
  return new TextEncoder().encode(
    JSON.stringify([
      AAD_LABEL,
      ENVELOPE_VERSION,
      context.type,
      context.from_device_id,
      context.to_device_id,
    ]),
  );
}

export function generate_room_key(): string {
  return bytes_to_base64url(
    crypto.getRandomValues(new Uint8Array(ROOM_KEY_BYTES)),
  );
}

// Canonical form only: re-encoding the decoded bytes must reproduce the
// input exactly, which rules out the non-zero trailing bits a 22-character
// base64url string could otherwise carry.
export function is_valid_room_key(candidate: string): boolean {
  if (candidate.length !== ROOM_KEY_ENCODED_LENGTH) {
    return false;
  }
  const bytes = base64url_to_bytes(candidate);
  return (
    bytes !== null &&
    bytes.length === ROOM_KEY_BYTES &&
    bytes_to_base64url(bytes) === candidate
  );
}

export async function import_room_key(encoded: string): Promise<CryptoKey> {
  const bytes = is_valid_room_key(encoded) ? base64url_to_bytes(encoded) : null;
  if (bytes === null) {
    throw new Error("invalid room key");
  }
  return crypto.subtle.importKey("raw", bytes, { name: "AES-GCM" }, false, [
    "encrypt",
    "decrypt",
  ]);
}

export function is_encrypted_signal_payload(
  value: unknown,
): value is EncryptedSignalPayload {
  if (typeof value !== "object" || value === null || Array.isArray(value)) {
    return false;
  }
  const record = value as Record<string, unknown>;
  return (
    record.v === ENVELOPE_VERSION &&
    typeof record.iv === "string" &&
    typeof record.ct === "string"
  );
}

export async function encrypt_signal_payload(
  key: CryptoKey,
  payload: unknown,
  context: SignalContext,
): Promise<EncryptedSignalPayload> {
  // Fresh random IV per message - never reused under the same key.
  const iv = crypto.getRandomValues(new Uint8Array(IV_BYTES));
  const plaintext = new TextEncoder().encode(JSON.stringify(payload));
  const ciphertext = await crypto.subtle.encrypt(
    { name: "AES-GCM", iv, additionalData: encode_aad(context) },
    key,
    plaintext,
  );
  return {
    v: ENVELOPE_VERSION,
    iv: bytes_to_base64url(iv),
    ct: bytes_to_base64url(new Uint8Array(ciphertext)),
  };
}

// Throws SignalDecryptionError for anything that fails authentication -
// wrong key, tampered ciphertext, or a context (type/sender/target) other
// than the one it was encrypted for. Callers must treat that as a possible
// attack, not a transient error to retry.
export async function decrypt_signal_payload(
  key: CryptoKey,
  envelope: EncryptedSignalPayload,
  context: SignalContext,
): Promise<unknown> {
  const iv = base64url_to_bytes(envelope.iv);
  const ciphertext = base64url_to_bytes(envelope.ct);
  if (iv === null || iv.length !== IV_BYTES || ciphertext === null) {
    throw new SignalDecryptionError("malformed encrypted payload");
  }
  let plaintext: ArrayBuffer;
  try {
    plaintext = await crypto.subtle.decrypt(
      { name: "AES-GCM", iv, additionalData: encode_aad(context) },
      key,
      ciphertext,
    );
  } catch {
    throw new SignalDecryptionError("encrypted payload failed verification");
  }
  try {
    return JSON.parse(new TextDecoder().decode(plaintext)) as unknown;
  } catch {
    throw new SignalDecryptionError("decrypted payload is not valid JSON");
  }
}
